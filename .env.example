# ── Core ──────────────────────────────────────────────────────────────────────
PRODUCTION=false
DEBUG=true
SECRET_KEY=change-me
# Must be a unique secret when DEBUG=false (app refuses to start otherwise). JWTs are signed with it.
# All /api/v1 endpoints (except /health) require a JWT from /api/token. Escape hatch: false.
API_REQUIRE_AUTH=true
HOST=http://localhost:8012
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Africa/Lagos

# ── CORS / CSRF ───────────────────────────────────────────────────────────────
# Production: CORS_ALLOW_ALL_ORIGINS=false and list the frontend origin(s) below (with scheme).
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8012,http://localhost:8012
CSRF_TRUSTED_ORIGINS=

# ── Database ──────────────────────────────────────────────────────────────────
# USE_SQLITE=true  → always SQLite (overrides DATABASE_ENGINE)   → docker compose up
# USE_SQLITE=false + DATABASE_ENGINE=postgres → Postgres          → docker compose --profile postgres up
USE_SQLITE=true
DATABASE_ENGINE=sqlite
SQLITE_NAME=/app/sqlite/db.sqlite3
DB_CONN_MAX_AGE=60

POSTGRES_DB=dealpipeline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CACHE_URL=redis://redis:6379/3
CACHE_LOCATION=dealpipeline-cache
CACHE_TIMEOUT=300

# ── Gunicorn ──────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL=webmaster@localhost

# ── API behaviour ─────────────────────────────────────────────────────────────
# Lists are paginated (?page=&page_size=). Default/maximum rows per page:
API_DEFAULT_PAGE_SIZE=500
API_MAX_PAGE_SIZE=1000
# Login throttling (per IP and per target username). Set NUM_PROXIES to the number of reverse
# proxies in front of the app (Render: check your setup) so client IPs are read correctly.
THROTTLE_LOGIN_PER_IP=20/min
THROTTLE_LOGIN_PER_USER=5/min
NUM_PROXIES=
# Evidence uploads
UPLOAD_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,csv,txt,png,jpg,jpeg
UPLOAD_MAX_MB=10
# Django admin path (trailing slash)
ADMIN_URL=admin/

# ── Logging / Security ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# When DEBUG=false the app redirects to HTTPS and sends HSTS by default (health check exempt).
# Set SECURE_SSL_REDIRECT=false only for local http testing with DEBUG=false.
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
